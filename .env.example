# Public Vite variables only. Never put private credentials in this file.
VITE_APP_NAME=SportManager
# URL del microservicio de seguridad (ProyectoDesarrolloBackend, puerto 8181)
VITE_API_URL=http://localhost:8181/api
# true = usar datos de prueba (src/services/mock); false = llamar al backend real
VITE_USE_MOCKS=true
# Configuración web pública de Firebase (Firebase Console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
